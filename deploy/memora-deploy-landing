#!/usr/bin/env bash
set -euo pipefail

# Memora landing page 服务器端部署辅助脚本。
#
# 注意：正式部署链路已经改为 GitHub Actions runner 构建 + rsync 推送
# (landing-page/.github/workflows/deploy.yml)，服务器不再需要 git/npm。
# 本脚本保留两个用途：
#   1) 手动部署 dist 目录：rsync 到站点 root（用法同下）
#   2) 供排查/回滚时直接操作站点目录
#
# 用法: memora-deploy-landing [SOURCE_DIR]
#   SOURCE_DIR  - dist 目录（默认 /opt/memora-landing-page/dist）
#   LANDING_SITE_ROOT 环境变量可覆盖站点 root（默认 /opt/memora-landing）

SITE_ROOT="${LANDING_SITE_ROOT:-/opt/memora-landing}"
SOURCE_DIR="${1:-/opt/memora-landing-page/dist}"

if [[ ! -d "$SOURCE_DIR" ]]; then
  echo "error: dist dir not found at $SOURCE_DIR" >&2
  exit 66
fi

install -d -m 0755 "$SITE_ROOT"
rsync -a --delete "$SOURCE_DIR/" "$SITE_ROOT/"

echo "landing deployed from $SOURCE_DIR to $SITE_ROOT"
