#!/usr/bin/env bash
set -euo pipefail

ROOT="${MEMORA_APK_ROOT:-/opt/memora-apk/android}"
INCOMING_ROOT="${MEMORA_APK_INCOMING:-$HOME/.memora-apk-incoming}"

usage() {
  echo "usage: memora-publish-apk prepare VERSION | verify VERSION SHA256 SIZE | activate VERSION SHA256 SIZE" >&2
  exit 64
}

validate_version() {
  local version="$1"
  if [[ ! "$version" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
    echo "invalid semantic version: $version" >&2
    exit 65
  fi
}

validate_release() {
  local version="$1"
  local expected_sha256="$2"
  local expected_size="$3"
  local incoming="$INCOMING_ROOT/$version"
  local apk="$incoming/app-release.apk"
  local manifest="$incoming/latest.json"
  local server_url="https://api.memora.wang/downloads/android/releases/v$version/Memora-v$version.apk"
  local github_url="https://github.com/JasonZhang453625/Article-Hub/releases/download/v$version/app-release.apk"

  [[ "$expected_sha256" =~ ^[a-f0-9]{64}$ ]] || {
    echo "invalid SHA-256" >&2
    exit 65
  }
  [[ "$expected_size" =~ ^[0-9]+$ ]] || {
    echo "invalid file size" >&2
    exit 65
  }
  [[ -f "$apk" && -f "$manifest" ]] || {
    echo "release files are incomplete in $incoming" >&2
    exit 66
  }

  local actual_sha256 actual_size
  actual_sha256=$(sha256sum "$apk" | awk '{print $1}')
  actual_size=$(stat -c '%s' "$apk")
  [[ "$actual_sha256" == "$expected_sha256" ]] || {
    echo "APK SHA-256 mismatch" >&2
    exit 66
  }
  [[ "$actual_size" == "$expected_size" ]] || {
    echo "APK size mismatch" >&2
    exit 66
  }

  jq -e \
    --arg version "$version" \
    --arg sha256 "$expected_sha256" \
    --arg server_url "$server_url" \
    --arg github_url "$github_url" \
    --argjson size "$expected_size" \
    '.version == $version
      and .sha256 == $sha256
      and .size == $size
      and .serverUrl == $server_url
      and .githubUrl == $github_url' \
    "$manifest" >/dev/null
}

command="${1:-}"
version="${2:-}"
[[ -n "$command" && -n "$version" ]] || usage
validate_version "$version"

case "$command" in
  prepare)
    [[ $# -eq 2 ]] || usage
    install -d -m 0750 "$INCOMING_ROOT/$version"
    rm -f "$INCOMING_ROOT/$version/app-release.apk" "$INCOMING_ROOT/$version/latest.json"
    ;;

  verify)
    [[ $# -eq 4 ]] || usage
    validate_release "$version" "$3" "$4"
    ;;

  activate)
    [[ $# -eq 4 ]] || usage
    validate_release "$version" "$3" "$4"

    incoming="$INCOMING_ROOT/$version"
    release_dir="$ROOT/releases/v$version"
    release_name="Memora-v$version.apk"
    release_apk="$release_dir/$release_name"
    temp_manifest="$ROOT/.latest.json.$$"
    temp_latest_link="$ROOT/.latest.apk.$$"
    temp_legacy_link="$ROOT/.app-release.apk.$$"

    install -d -m 0755 "$ROOT/releases" "$release_dir"
    if [[ -e "$release_apk" ]]; then
      existing_sha256=$(sha256sum "$release_apk" | awk '{print $1}')
      [[ "$existing_sha256" == "$3" ]] || {
        echo "refusing to overwrite immutable release $release_apk" >&2
        exit 66
      }
    else
      install -m 0644 "$incoming/app-release.apk" "$release_apk"
    fi

    trap 'rm -f "$temp_manifest" "$temp_latest_link" "$temp_legacy_link"' EXIT
    install -m 0644 "$incoming/latest.json" "$temp_manifest"
    ln -s "releases/v$version/$release_name" "$temp_latest_link"
    ln -s "releases/v$version/$release_name" "$temp_legacy_link"

    mv -Tf "$temp_latest_link" "$ROOT/latest.apk"
    mv -Tf "$temp_legacy_link" "$ROOT/app-release.apk"
    mv -f "$temp_manifest" "$ROOT/latest.json"
    trap - EXIT
    rm -f "$incoming/app-release.apk" "$incoming/latest.json"
    rmdir "$incoming"
    ;;

  *)
    usage
    ;;
esac
