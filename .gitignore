migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/
/tools/*
!/tools/bump_version.dart

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Android signing — NEVER commit these.
# Lose your upload key and you can no longer update your Play Store app.
/android/key.properties
/android/app/upload-keystore.jks
/android/app/*.jks
/android/app/*.keystore

# Kotlin compiler session/build artifacts
.kotlin/
**/.kotlin/

# Playwright MCP working dir (local tooling artifacts)
.playwright-mcp/

# Local AI coding assistant state
/.agents/
/.claude/
/.codex/
/.mimocode/

# Local scratch / working dir
/tmp/

# Local deployment credentials (never commit)
/apikey.txt

# Personal / research artifacts (not for public repo)
/docs/简历_项目经历_优化版.md
/docs/调研问卷.docx
